# Cloudflare Pages reads this file. Rules are matched top-down, most specific first.

# NOT immutable. These filenames are not all content-hashed, and "immutable"
# tells the browser never to re-check — so replacing a photo under the same name
# left visitors pinned to the old one for a year with no way to bust it. A day
# of freshness plus background revalidation keeps the bandwidth win without the
# trap. Files that ARE hashed (e.g. dr-basantani.<hash>.jpeg) get a new URL when
# they change, so this is belt and braces.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=604800

# The page itself must revalidate, or edits take a day to reach returning
# visitors and Google sees stale markup.
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Every HTML page needs the same treatment, not just the homepage — without
# this the blog served a stale copy after deploy, including a stale canonical.
/blog/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# Crawlers should always get the current version of these.
# Short TTL: new pages are being added, and Google should see them on its
# next fetch rather than up to an hour late.
/sitemap.xml
  Cache-Control: public, max-age=300, must-revalidate
/robots.txt
  Cache-Control: public, max-age=3600
