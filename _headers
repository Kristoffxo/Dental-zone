# Cloudflare Pages reads this file. Rules are matched top-down, most specific first.

# Fingerprinted-by-content assets. These filenames only change when the picture
# changes, so a year of caching is safe and takes repeat visits to near-zero
# image bytes — which is most of this page's weight.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable
/favicon.ico
  Cache-Control: public, max-age=604800

# The page itself must revalidate, or edits take a day to reach returning
# visitors and Google sees stale markup.
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Every HTML page needs the same treatment, not just the homepage — without
# this the blog served a stale copy after deploy, including a stale canonical.
/blog/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# Crawlers should always get the current version of these.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
